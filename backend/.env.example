PORT=4100
# Comma-separated list, e.g. https://sportsjedi.com,https://www.sportsjedi.com
FRONTEND_ORIGIN=http://localhost:5173
SPORTS_JEDI_URL=http://localhost:5173

# mock | theoddsapi | hybrid | espn
#   theoddsapi  The Odds API only (current production behaviour)
#   hybrid      Odds API lines + free ESPN status/scores/records, ESPN takes over if the Odds API fails
#   espn        free ESPN data only (no key, no quota, no player props)
SPORTS_PROVIDER=mock
SPORTS_API_KEY=
SPORTS_API_BASE=
SPORTS_ODDS_REGIONS=us
SPORTS_CACHE_MS=

# Free ESPN source tuning (optional)
ESPN_CACHE_MS=30000
ESPN_FUTURE_CACHE_MS=300000
ESPN_WINDOW_DAYS=9

# Protects /api/sources/status and /api/sources/compare (16+ chars)
SOURCES_ADMIN_TOKEN=

# Billing (routes return 503 until these are set)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
