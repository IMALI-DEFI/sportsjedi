    if (legs.length < 2) {
      setError(
        "Add at least 2 picks."
      );
      return;
    }

    setLoading(true);
    setError("");

    try {
      const result =
        await api.playerParlay(
          legs
        );

      setAnalysis(result);
    } catch (err) {
      if (err.code === "AUTH_REQUIRED") {
        setGate({ code: err.code, text: "Make a free account to check your parlay. It only takes a minute." });
        setError("");
        return;
      }
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

