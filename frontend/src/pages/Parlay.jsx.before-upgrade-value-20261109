  useEffect(() => {
    setProps([]);
    setLegs([]);
    setAnalysis(null);
    setSelectedGame(scopedEventId || "ALL");
    setError("");

    const controller = new AbortController();
    fetch(
      `${API}/api/picks/props?league=${league}`,
      {signal: controller.signal,
       headers: (() => {
         const token = localStorage.getItem("sports_jedi_token");
         return token ? {Authorization: `Bearer ${token}`} : {};
       })()}
    )
      .then(async (response) => {
        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.error || "Unable to load props"
          );
        }

        setProps(result.data || []);
      })
      .catch((err) => {if(err.name !== "AbortError") setError(err.message)});
    return () => controller.abort();
  }, [league]);

  const games = useMemo(() => {
    const ids = new Map();

    for (const prop of props) {
      if (
        prop.eventId &&
        !ids.has(prop.eventId)
      ) {
        ids.set(
          prop.eventId,
          prop.matchup ||
            prop.eventId.slice(0, 8)
        );
      }
    }

    return [...ids.entries()];
  }, [props]);

  const visibleProps = useMemo(() => {
    const filtered =
      scopedEventId ? props.filter(prop => String(prop.eventId) === String(scopedEventId)) : selectedGame === "ALL"
