      setAnalysis({
        impliedProbability:
          result.impliedProbability,
        combinedAmerican:
          result.combinedAmerican,
        combinedDecimal:
          result.combinedDecimal,
        risk:
          result.risk,
        sameGame:
          result.sameGame,
        warnings:
          result.warnings?.length
            ? result.warnings
            : result.warning
              ? [result.warning]
              : [],
      });
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  async function generateAutoParlay(mode) {
    try {
      setLoading(true);
      setError("");
      setGate(null);
      setLegs([]);
      setAnalysis(null);

      const result =
        await api.autoParlay(
          league,
          mode,
          scopedEventId
        );

      setLegs(result.selections || []);
      setGate(null);
      setAccessNote(result.access?.plan === "free" ? "That was your free auto parlay for today. Go Pro for unlimited." : "");

      setAnalysis({
        impliedProbability: result.impliedProbability,
        combinedAmerican: result.combinedAmerican,
        combinedDecimal: result.combinedDecimal,
        risk: result.risk,
        sameGame: result.sameGame,
        warnings:
          result.warnings?.length
            ? result.warnings
            : result.warning
              ? [result.warning]
              : [],
      });
    } catch (err) {
      if (["AUTH_REQUIRED", "FREE_LIMIT_REACHED", "PRO_REQUIRED"].includes(err.code)) {
        setGate({ code: err.code, text: err.message });
        setError("");
      } else {
        setError(err.message);
      }
    } finally {
      setLoading(false);
    }
  }

